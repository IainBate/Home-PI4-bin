find /mnt/HDD/ -mindepth 1 -maxdepth 1 -type d -not -path '*/\.*' | while read n; do
	m=$(echo "$n"|sed 's/\/mnt\/HDD\///')
	if [[ "$n" != *"tmp"* && "$n" != *"photos"* && "$n" != *"files"* && "$n" != *"Go Pros"* && "$n" != *"PI backup"* ]]; then
		if [[ "$n" != *"lost+found"* && "$n" != *"olympus_tg4"* && "$n" != *"iPhones"* && "$n" != *"Trash"* ]]; then
			echo "rsync'ing" "$n/" "/media/pi/Caravan/$m/"
			mkdir -p "/media/pi/Caravan/$m/"
			if [[ "$n" != *"iTunes"* ]]; then
				rsync --archive --delete --progress --delete-excluded --exclude "/Friends" --exclude "/Modern Family" --exclude "/H2O - Just Add Water" --exclude "*DS_Store*" "$n/" /media/pi/Caravan/"$m"/
			else
			        rsync --archive --delete --progress --delete-excluded --exclude "*DS_Store*" --exclude "/Friends" --exclude "/iTunes Media" --exclude "/Automatically Add to TV.localized" --exclude "/Album Artwork" "$n/" /media/pi/Caravan/"$m"/
			fi
		fi
	fi
done

