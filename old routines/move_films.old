for film in *HD.mp4; do film1=`echo "$film" | sed -e 's/_iPad//g'`; genre=`ffmpeg -i "$film" 2>&1 |grep genre|awk '{ print $3 }'`; mv -v "$film" /mnt/HDD/films/$genre/"$film1"; done
for film in *iPad.mp4; do film1=`echo "$film" | sed -e 's/_iPad//g'`; mv -v "$film" /mnt/HDD/iTunes/iTunes\ Media/Home\ Videos/"$film1"; done
