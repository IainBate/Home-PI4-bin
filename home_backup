#!/bin/bash

MSMTP_CONF="/home/pi/.msmtprc"
ALERT_TO="iain.bate@gmail.com"
HEALTHCHECK_URL="https://hc-ping.com/7e663dd8-7b68-48fe-83d8-664b4e8c7837"

FAILURES=()
WARNINGS=()

run() {
	local desc="$1"; shift
	"$@"
	local rc=$?
	if [ $rc -eq 24 ]; then
		WARNINGS+=("[$desc] rsync exit 24 (source file vanished mid-transfer, usually harmless): $*")
	elif [ $rc -ne 0 ]; then
		FAILURES+=("[$desc] exit $rc: $*")
	fi
	return 0
}

# Try each mount up to 3 times before giving up. Uses "sudo mount
# <mount_point>" against the /etc/fstab entry (not "udisksctl mount -b
# <device>") - confirmed 2026-09-02 that udisksctl requires an interactive
# polkit authentication agent tied to a controlling terminal, which never
# exists when this runs from cron (or a non-interactive SSH command), so it
# failed on every attempt regardless of retries. sudo is passwordless for
# pi on this Pi (see "sudo -l"), so this needs no agent. If udisksctl
# silently failed and we only wrote into the mount point directory itself,
# every rsync below would have quietly filled the SD card with a full copy
# of the main HDD instead of erroring loudly. A single flaky attempt
# shouldn't skip a whole backup step, so retry with a pause before treating
# it as a real failure (which reaches you via the existing FAILURES/email
# mechanism below).
mount_with_retry() {
	local desc="$1" mount_point="$2" attempts=3 i
	for i in $(seq 1 "$attempts"); do
		if mountpoint -q "$mount_point"; then
			return 0
		fi
		sudo mount "$mount_point" >/dev/null 2>&1
		sleep 10
		if mountpoint -q "$mount_point"; then
			return 0
		fi
		echo "[$desc] mount attempt $i/$attempts did not succeed"
	done
	FAILURES+=("[$desc] failed to mount $mount_point after $attempts attempts - skipping steps that write there to avoid filling the SD card")
	return 1
}

HDD_PHOTOS_MOUNTED=0
HDD_BACKUP_MOUNTED=0
mount_with_retry "mount HDD_photos" /mnt/HDD_photos && HDD_PHOTOS_MOUNTED=1
mount_with_retry "mount HDD_backup" /mnt/HDD_backup && HDD_BACKUP_MOUNTED=1

echo "Backing up home automation, bin, etc"
run "rsync home_automation" rsync --archive --delete --progress /home/pi/home_automation/ /mnt/HDD/files/home_automation/
run "rsync /home/pi -> files/usr" rsync --archive --delete --progress /home/pi/ /mnt/HDD/files/usr/
run "rsync bin" rsync --archive --delete --progress /home/pi/bin/ /mnt/HDD/files/bin/
# sudo: /etc contains some root-only-readable files (Samba config,
	# systemd unit symlinks) that plain "pi" cannot read/preserve -
	# confirmed 2026-09-02 this was causing "Permission denied"/exit 23
	# on every run, not just when a drive is missing.
	run "rsync /etc" sudo rsync --archive --delete --progress /etc/ /mnt/HDD/files/etc/

if [ "$HDD_BACKUP_MOUNTED" -eq 1 ]; then
	echo "Backing up the HDD drive"
	while read -r n; do
		m=$(echo "$n"|sed 's/\/mnt\/HDD\///')
		if [[ "$n" != *"films"* ]]; then
			echo "rsync'ing" "$n/" "/mnt/HDD_backup/$m/"
			mkdir -p "/mnt/HDD_backup/$m/"
			# "files" is the tree written by the /etc rsync above (now sudo,
			# so partly root-owned) - needs sudo here too to read it back,
			# same reasoning as that step.
			if [ "$m" = "files" ]; then
				run "rsync HDD/$m -> HDD_backup" sudo rsync --archive --delete --progress --delete-excluded "$n/" /mnt/HDD_backup/"$m"/
			else
				run "rsync HDD/$m -> HDD_backup" rsync --archive --delete --progress --delete-excluded "$n/" /mnt/HDD_backup/"$m"/
			fi
		fi
	done < <(find /mnt/HDD/ -mindepth 1 -maxdepth 1 -type d -not -path '*/\.*')
else
	echo "Skipping HDD -> HDD_backup sync: HDD_backup is not mounted"
fi

if [ "$HDD_PHOTOS_MOUNTED" -eq 1 ] && [ "$HDD_BACKUP_MOUNTED" -eq 1 ]; then
	run "rsync photos" rsync --archive --delete --progress /mnt/HDD_photos/photos/ /mnt/HDD_backup/photos/
else
	echo "Skipping photos sync: HDD_photos and/or HDD_backup is not mounted"
fi

sleep 10
# Only unmount what we actually mounted - unconditionally unmounting both
# would log a spurious extra failure on top of the real "failed to mount"
# one already recorded above, for a drive that was never mounted.
[ "$HDD_PHOTOS_MOUNTED" -eq 1 ] && run "unmount HDD_photos" sudo umount /mnt/HDD_photos
[ "$HDD_BACKUP_MOUNTED" -eq 1 ] && run "unmount HDD_backup" sudo umount /mnt/HDD_backup
sleep 10

echo "Checking films_backup / lucys_backup freshness"
# Checks the *success* marker (touched by films_backup only when rsync
# exits 0 or 24), not the log file - the log is rewritten on every run
# regardless of outcome, so it would never go stale even if the backup
# fails every time. Keep these paths in sync with films_backup's
# LOGFILE/SUCCESS_MARKER definitions.
check_stale() {
	local desc="$1" marker="$2" logfile="$3" max_days="$4"
	if [ ! -f "$marker" ]; then
		FAILURES+=("[$desc] no successful run recorded ($marker missing) - has it ever completed? (log: $logfile)")
	elif [[ $(find "$marker" -mtime +$max_days -print) ]]; then
		FAILURES+=("[$desc] last successful run was more than $max_days days ago - backup may be overdue (log: $logfile)")
	fi
}
check_stale "films_backup" /home/pi/logs/films_backup_success /home/pi/logs/films_backup_logfile 31
check_stale "lucys_backup" /home/pi/logs/lucys_backup_success /home/pi/logs/lucys_backup_logfile 31

if [ ${#FAILURES[@]} -gt 0 ]; then
	SUBJECT="[PI4] home_backup FAILED - $(date '+%Y-%m-%d %H:%M')"
	{
		echo "To: $ALERT_TO"
		echo "Subject: $SUBJECT"
		echo
		echo "SUMMARY: home_backup on HomePI4 hit ${#FAILURES[@]} failure(s) at $(date '+%Y-%m-%d %H:%M %Z')."
		echo
		echo "FAILED STEPS:"
		for f in "${FAILURES[@]}"; do echo "  - $f"; done
		if [ ${#WARNINGS[@]} -gt 0 ]; then
			echo
			echo "WARNINGS (non-fatal):"
			for w in "${WARNINGS[@]}"; do echo "  - $w"; done
		fi
		echo
		echo "ENVIRONMENT:"
		echo "  Host: homepi4  (ssh pi@100.102.156.19)"
		echo "  Script: /home/pi/bin/home_backup"
		echo "  Full run log: /tmp/home_backup_logfile (on the Pi)"
		echo "  Local git mirror: ~/Home_PI4_bin/home_backup (github.com/IainBate/Home-PI4-bin)"
		echo
		echo "SUGGESTED NEXT STEP:"
		echo "  Paste this email into Claude Code in the Home_PI4_bin project and ask it to"
		echo "  investigate. It already knows how to reach the Pi (ssh pi@100.102.156.19"
		echo "  via Tailscale) and has reviewed this script and the drive/fstab layout, so it"
		echo "  can go straight to diagnosing the failed step(s) above."
		echo
		echo "--- last 60 lines of /tmp/home_backup_logfile ---"
		tail -n 60 /tmp/home_backup_logfile 2>/dev/null
	} | msmtp --file="$MSMTP_CONF" -t

	if [ -n "$HEALTHCHECK_URL" ]; then
		curl -fsS -m 10 --retry 3 "$HEALTHCHECK_URL/fail" -o /dev/null
	fi
else
	if [ -n "$HEALTHCHECK_URL" ]; then
		curl -fsS -m 10 --retry 3 "$HEALTHCHECK_URL" -o /dev/null
	fi
fi
