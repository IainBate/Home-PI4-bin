#!/bin/bash

# Use Case:
# - Default: GPU encoding (h264_v4l2m2m), outputs to /mnt/HDD/films/{genre}/
# - No GPU: Uses libx264 (triggered by -n or if primary fails)
# - 1080p scaling: Adds scale=1920:1080 filter (triggered by -s)
# - Audio selection: Stream index (triggered by -a)
# - Subtitles: Hard-encode or include forced English subs
# - Colon replacement: In filename and metadata (triggered by -c)
# - Olympus mode: Batch process .MOV files with date-based naming (triggered by --olympus)

# Usage: ./convert_video [options] <filename> [title] <genre>
#        ./convert_video [options] <filename> <genre>
#        ./convert_video --olympus <directory>
#
# Arguments:
#   With 2 args: <filename> <genre> - Original behavior
#   With 3 args: <filename> <title> <genre> - Title used for output filename and metadata
#
# Options:
#   -n, --no-gpu      Force software encoding (libx264)
#   -s, --1080p       Scale 2160p down to 1080p
#   -a, --audio <id>  Specify audio stream index (default: 0)
#   -h, --hard_sub    Hard encode all subtitles
#   --forced          Include only forced English subtitles without prompting
#   -c, --colon       Replace dashes with colons in filename and metadata
#   --olympus         Olympus .MOV batch mode (date-based naming, libx264)

# Legacy script equivalents:
#   ./convert_video_just_HD <file>             => ./convert_video <file>
#   ./convert_video_without_GPU_just_HD <file> => ./convert_video -n <file>
#   ./convert_video_both_HD_and_iPad <file>    => ./convert_video <file> (HD only, iPad obsolete)
#   ./convert_olympus_videos.py <dir>          => ./convert_video --olympus <dir>

# Variables
OUTPUT_ENC="h264_v4l2m2m"
SCALE_FILTER=""
AUDIO_INDEX=0
HARD_SUB=false
FORCED_SUBS=false
FORCE_NO_GPU=false
REPLACE_COLON=false
OLYMPUS_MODE=false
TARGET_DIR="."

# Parse options
while [[ "$#" -gt 0 ]]; do
    case $1 in
        -n|--no-gpu)
            OUTPUT_ENC="libx264"
            FORCE_NO_GPU=true
            shift
            ;;
        -s|--1080p)
            SCALE_FILTER="-vf scale=1920:1080"
            shift
            ;;
        -a|--audio)
            AUDIO_INDEX=$2
            shift 2
            ;;
        -h|--hard_sub)
            HARD_SUB=true
            shift
            ;;
        -c|--colon)
            REPLACE_COLON=true
            shift
            ;;
        --forced)
            FORCED_SUBS=true
            shift
            ;;
        --olympus)
            OLYMPUS_MODE=true
            TARGET_DIR="${2:-.}"
            shift 2
            ;;
        *)
            break
    esac
done

if [ "$OLYMPUS_MODE" = "true" ]; then
    # Olympus mode: process directory, no genre argument needed
    dirname="$TARGET_DIR"
else
    filename=$1

    # Handle 2 or 3 arguments for standard mode
    if [[ -z "$filename" ]]; then
        echo "Usage: $0 [-n] [-s] [-a <id>] [--hard_sub | --forced] [-c] <filename> [title] <genre>"
        echo ""
        echo "Arguments:"
        echo "  2 args: <filename> <genre>          - Original behavior"
        echo "  3 args: <filename> <title> <genre>  - Title used for output filename and metadata"
        echo ""
        echo "Options:"
        echo "  -n, --no-gpu      Force software encoding (libx264)"
        echo "  -s, --1080p       Scale 2160p down to 1080p"
        echo "  -a, --audio <id>  Specify audio stream index (default: 0)"
        echo "  --hard_sub        Hard encode all subtitles"
        echo "  --forced          Include only forced English subtitles without prompting"
        echo "  -c, --colon       Replace dashes with colons in filename and metadata"
        exit 1
    fi

    if [[ $# -eq 2 ]]; then
        # 2 arguments: filename genre (original behavior)
        genre=$2
        USE_THREE_ARG_MODE=false
    elif [[ $# -ge 3 ]]; then
        # 3+ arguments: filename title genre (new behavior)
        output_title="$2"
        genre="$3"
        USE_THREE_ARG_MODE=true
    else
        echo "Error: At least filename argument required"
        exit 1
    fi
fi

# Handle special cases for Modern and Retro genres
if [[ "$genre" == "Modern" || "$genre" == "Retro" ]]; then
    METADATA_GENRE="Family"
    DEST_PATH="Family/$genre"
else
    METADATA_GENRE="$genre"
    DEST_PATH="$genre"
fi

if [ "$HARD_SUB" = "true" ] && [ "$FORCED_SUBS" = "true" ]; then
    echo "Error: Cannot use both -h/--hard_sub and --forced together"
    exit 1
fi

# --- Olympus Mode Processing ---
if [ "$OLYMPUS_MODE" = "true" ]; then
    echo "Processing Olympus .MOV files in directory: $dirname"

    # Change to target directory
    cd "$dirname" || exit 1

    # Process all .MOV files
    for file in *.MOV; do
        [ -e "$file" ] || continue

        PID=$$
        filename="$file"
        OUTPUT_ENC="libx264"  # Olympus mode always uses libx264

        # Extract date from file modification time for naming
        file_date=$(date -r "$filename" "+%d_%m_%Y")
        new_filename="Movie ${file_date}.mp4"

        echo "Processing: $filename -> $new_filename"

        touch -r "$filename" .timestamp_$PID

        # Build and run ffmpeg command (no scaling, date-based naming)
        ffmpeg -y -i "$filename" -threads 4 -map_metadata 0 -map 0:v:0 -c:v libx264 -crf 21 -map 0:a:0 -q:a 1 "$new_filename" </dev/null

        # Fix timestamp
        touch -r .timestamp_$PID "$new_filename"

        # Remove original if conversion succeeded
        if [ $? -eq 0 ]; then
            rm -v "$filename"
        fi

        rm -f .timestamp_$PID
    done

    echo "Olympus processing complete."
    exit 0
fi

# --- Standard File Mode Processing ---

# --- Preparation ---
PID=$$
filename1=$(basename "$filename")
prefix=$(echo "${filename1%.*}")
prefix1=$(echo "${filename%.*}")

# Determine output title and prefix based on argument mode
if [ "$USE_THREE_ARG_MODE" = "true" ]; then
    # 3-arg mode: use provided title for output filename and metadata
    output_prefix="$output_title"
    if [ "$REPLACE_COLON" = "true" ]; then
        output_prefix=$(echo "$output_title" | sed 's/ -/:/')
    fi
else
    # 2-arg mode: original behavior - use input filename without extension
    if [ "$REPLACE_COLON" = "true" ]; then
        output_prefix=$(echo "$prefix" | sed 's/ -/:/')
    else
        output_prefix="$prefix"
    fi
fi

new_filename="${output_prefix}.mp4"
new_filename_HD="${output_prefix}_HD.mp4"
new_filename_iPad="${output_prefix}_iPad.mp4"

echo "Original file name: $filename"
echo "Prefix: $prefix"
if [ -n "$output_title" ]; then
    echo "Output title: $output_title"
fi
echo "New file names: ${new_filename_iPad} ${new_filename_HD} ${new_filename}"

target_bitrate=2000
# Just to keep it similar to original script's behavior of showing info
ffmpeg -i "$filename" 2>&1 | grep -E "Duration|bitrate" || true
echo "Target bitrate: ${target_bitrate}k"

# --- Subtitle Detection and Processing ---

# Function to check if a subtitle stream is English and forced
check_english_forced_sub() {
    local stream_info="$1"

    # Check if it's an English forced subtitle stream
    # Pattern: Stream #0:X(eng): Subtitle: ... (forced)
    if echo "$stream_info" | grep -q "Subtitle.* eng .*forced\|Subtitle.*forced.*eng"; then
        return 0
    fi

    # Alternative pattern matching
    if echo "$stream_info" | grep -E "Stream #0:[0-9]+\(eng\): Subtitle:.*forced" > /dev/null; then
        return 0
    fi

    return 1
}

# Function to get subtitle stream info and count forced English subs
analyze_subtitles() {
    local filename="$1"

    echo "Analyzing subtitles..."

    # Get all subtitle streams info
    SUBTITLE_INFO=$(ffmpeg -i "$filename" 2>&1)

    FORCED_ENG_SUBS=()
    ALL_SUB_STREAMS=()

    # Extract all subtitle stream lines
    while IFS= read -r line; do
        if echo "$line" | grep -q "Subtitle:"; then
            ALL_SUB_STREAMS+=("$line")

            # Check if this is a forced English subtitle
            if check_english_forced_sub "$line"; then
                FORCED_ENG_SUBS+=("$line")
            fi
        fi
    done <<< "$SUBTITLE_INFO"

    echo "Found ${#ALL_SUB_STREAMS[@]} subtitle stream(s)"

    # Check for external SRT files
    dir=$(dirname "$filename")
    base="${filename1%.*}"
    EXTERNAL_SRT_FILES=()

    # Look for .srt files in same directory matching the video basename or generic srt patterns
    while IFS= read -r -d '' srt_file; do
        if [[ "$srt_file" != "" ]]; then
            EXTERNAL_SRT_FILES+=("$srt_file")
        fi
    done < <(find "$dir" -maxdepth 1 -type f -name "*.srt" -print0 2>/dev/null | sort -z)

    echo "Found ${#EXTERNAL_SRT_FILES[@]} external subtitle file(s)"

    # Calculate forced coverage if we have forced English subs
    FORCED_COVERAGE_PCT=0

    if [[ ${#FORCED_ENG_SUBS[@]} -gt 0 ]]; then
        # Get video duration in seconds
        VIDEO_DURATION=$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$filename" 2>/dev/null)

        if [[ -n "$VIDEO_DURATION" && "$VIDEO_DURATION" != "N/A" ]]; then
            # Extract forced subtitle durations using ffprobe packet data
            TOTAL_FORCED_DURATION=0

            for sub_stream in "${FORCED_ENG_SUBS[@]}"; do
                # Extract stream index from line like "Stream #0:2(eng): Subtitle..."
                STREAM_IDX=$(echo "$sub_stream" | sed -n 's/.*Stream #0:\([0-9]\+\).*/\1/p')

                if [[ -n "$STREAM_IDX" ]]; then
                    # Get subtitle packet times for this stream
                    PACKET_DATA=$(ffprobe -v error -select_streams s:$STREAM_IDX -show_entries packet=pts_time,duration -of csv=p=0 "$filename" 2>/dev/null)

                    while IFS=',' read -r pts duration; do
                        if [[ -n "$duration" && "$duration" != "N/A" ]]; then
                            TOTAL_FORCED_DURATION=$(echo "$TOTAL_FORCED_DURATION + $duration" | bc 2>/dev/null || echo "$TOTAL_FORCED_DURATION")
                        fi
                    done <<< "$PACKET_DATA"
                fi
            done

            if [[ -n "$VIDEO_DURATION" && "$VIDEO_DURATION" != "0" ]]; then
                FORCED_COVERAGE_PCT=$(echo "scale=1; ($TOTAL_FORCED_DURATION / $VIDEO_DURATION) * 100" | bc 2>/dev/null || echo "0")
            fi

            # Round to integer for display
            FORCED_COVERAGE_PCT_INT=$(printf "%.0f" "$FORCED_COVERAGE_PCT" 2>/dev/null || echo "0")

            if [[ ${#EXTERNAL_SRT_FILES[@]} -gt 0 ]]; then
                echo "Forced English subtitle coverage: ${FORCED_COVERAGE_PCT}% of video"
            fi
        fi
    fi

    # Store results for later use
    FORCED_ENG_COUNT=${#FORCED_ENG_SUBS[@]}
}

# Function to prompt user about low-coverage forced subtitles
prompt_for_subtitles() {
    local coverage="$1"

    echo ""
    echo "English forced subtitle coverage: ${coverage}% of video runtime"

    if (( $(echo "$coverage < 15" | bc -l 2>/dev/null || echo "1") )); then
        echo "Note: Low coverage may indicate director commentary rather than foreign language support."
        echo ""
        read -p "Include these English subtitles? [Y/n] " response

        case "$response" in
            [nN]|[nN][oO])
                INCLUDE_SUBTITLES=false
                return 0
                ;;
            *)
                INCLUDE_SUBTITLES=true
                return 1
                ;;
        esac
    else
        echo "Coverage is above threshold (15%), including forced English subtitles by default."
        INCLUDE_SUBTITLES=true
        return 1
    fi
}

# --- Subtitle Processing ---
FORCED_SUB_MAP=""
SUBTITLE_CODEC=""
INCLUDE_SUBTITLES=false

if [ "$HARD_SUB" = "true" ]; then
    # Hard-encode all subtitles (existing behavior)
    echo "Hard-encoding all embedded subtitles..."
elif [ "$FORCED_SUBS" = "true" ]; then
    # User explicitly requested forced subtitles - use without prompting
    echo "Including forced English subtitles as requested..."

    if [[ ${#ALL_SUB_STREAMS[@]} -gt 0 ]]; then
        # Find first English forced subtitle stream
        for sub_line in "${ALL_SUB_STREAMS[@]}"; do
            if check_english_forced_sub "$sub_line"; then
                STREAM_IDX=$(echo "$sub_line" | sed -n 's/.*Stream #0:\([0-9]\+\).*/\1/p')
                if [[ -n "$STREAM_IDX" ]]; then
                    FORCED_SUB_MAP="-map 0:s:$STREAM_IDX"
                    SUBTITLE_CODEC="-c:s mov_text -metadata:s:s:0 language=eng"
                    INCLUDE_SUBTITLES=true
                    echo "Found forced English subtitle stream at index $STREAM_IDX"
                    break
                fi
            fi
        done

        if [ "$INCLUDE_SUBTITLES" = false ]; then
            # Try any English subtitle as fallback
            for sub_line in "${ALL_SUB_STREAMS[@]}"; do
                if echo "$sub_line" | grep -q "eng"; then
                    STREAM_IDX=$(echo "$sub_line" | sed -n 's/.*Stream #0:\([0-9]\+\).*/\1/p')
                    if [[ -n "$STREAM_IDX" ]]; then
                        FORCED_SUB_MAP="-map 0:s:$STREAM_IDX"
                        SUBTITLE_CODEC="-c:s mov_text -metadata:s:s:0 language=eng"
                        INCLUDE_SUBTITLES=true
                        echo "Found English subtitle stream at index $STREAM_IDX (not marked forced)"
                        break
                    fi
                fi
            done
        fi

        if [ "$INCLUDE_SUBTITLES" = false ]; then
            echo "Warning: No English subtitle streams found"
        fi
    else
        echo "Warning: No subtitle streams found in input file"
    fi

    # Check for external SRT files and append to mapping
    if [[ ${#EXTERNAL_SRT_FILES[@]} -gt 0 ]]; then
        for srt_file in "${EXTERNAL_SRT_FILES[@]}"; do
            echo "Found external subtitle: $(basename "$srt_file")"
        done

        # For now, just note them - we'll add them as a separate stream if needed
    fi
else
    # Auto-detect mode - analyze subtitles and prompt if needed
    analyze_subtitles "$filename"

    if [[ ${#FORCED_ENG_SUBS[@]} -gt 0 ]]; then
        echo ""

        # Prompt user (unless coverage is high)
        if (( $(echo "$FORCED_COVERAGE_PCT >= 15" | bc -l 2>/dev/null || echo "0") )); then
            INCLUDE_SUBTITLES=true
            echo "Forced English subtitles detected with ${FORCED_COVERAGE_PCT}% coverage."
            echo "Including automatically (above 15% threshold)."
        else
            prompt_for_subtitles "$FORCED_COVERAGE_PCT"
        fi

        # Map the first forced English subtitle stream if we decided to include
        if [ "$INCLUDE_SUBTITLES" = true ]; then
            for sub_line in "${ALL_SUB_STREAMS[@]}"; do
                if check_english_forced_sub "$sub_line"; then
                    STREAM_IDX=$(echo "$sub_line" | sed -n 's/.*Stream #0:\([0-9]\+\).*/\1/p')
                    if [[ -n "$STREAM_IDX" ]]; then
                        FORCED_SUB_MAP="-map 0:s:$STREAM_IDX"
                        SUBTITLE_CODEC="-c:s mov_text -metadata:s:s:0 language=eng"
                        echo "Mapping forced English subtitle stream at index $STREAM_IDX"
                        break
                    fi
                fi
            done

            # If no forced stream found but we have English streams, use first one
            if [[ -z "$FORCED_SUB_MAP" ]]; then
                for sub_line in "${ALL_SUB_STREAMS[@]}"; do
                    if echo "$sub_line" | grep -q "eng"; then
                        STREAM_IDX=$(echo "$sub_line" | sed -n 's/.*Stream #0:\([0-9]\+\).*/\1/p')
                        if [[ -n "$STREAM_IDX" ]]; then
                            FORCED_SUB_MAP="-map 0:s:$STREAM_IDX"
                            SUBTITLE_CODEC="-c:s mov_text -metadata:s:s:0 language=eng"
                            echo "Mapping English subtitle stream at index $STREAM_IDX"
                            break
                        fi
                    fi
                done
            fi

            # Add external SRT files if present
            if [[ ${#EXTERNAL_SRT_FILES[@]} -gt 0 ]]; then
                SRT_COUNT=${#EXTERNAL_SRT_FILES[@]}
                echo "Including $SRT_COUNT external subtitle file(s)"

                # For each external SRT, add as a stream
                for i in "${!EXTERNAL_SRT_FILES[@]}"; do
                    srt_path="${EXTERNAL_SRT_FILES[$i]}"
                    FORCED_SUB_MAP="$FORCED_SUB_MAP -attach \"$srt_path\" -metadata:s:t:$((i)) mimetype=application/x-subrip"
                done

                # Also hard-encode the first external SRT if desired
                # This requires using the subtitles filter
                FIRST_SRT="${EXTERNAL_SRT_FILES[0]}"
                echo "Note: External subtitle $(basename "$FIRST_SRT") will be included as data stream"
            fi
        fi
    else
        echo "No English forced subtitles detected."
        INCLUDE_SUBTITLES=false

        # Check for external SRT files anyway
        if [[ ${#EXTERNAL_SRT_FILES[@]} -gt 0 ]]; then
            echo ""
            echo "External subtitle file(s) found:"
            for srt_file in "${EXTERNAL_SRT_FILES[@]}"; do
                echo "  - $(basename "$srt_file")"
            done

            read -p "Include these external subtitles? [y/N] " response
            case "$response" in
                [yY]|[yY][eE][sS])
                    INCLUDE_SUBTITLES=true
                    # Map each SRT as a data stream
                    for i in "${!EXTERNAL_SRT_FILES[@]}"; do
                        srt_path="${EXTERNAL_SRT_FILES[$i]}"
                        FORCED_SUB_MAP="$FORCED_SUB_MAP -attach \"$srt_path\" -metadata:s:t:$((i)) mimetype=application/x-subrip"
                    done
                    ;;
            esac
        fi
    fi
fi

touch -r "$filename" .timestamp_$PID

# Helper function to generate the ffmpeg command string
build_cmd() {
    local enc=$1
    # Use output prefix for metadata title (use original prefix if not in 3-arg mode)
    if [ "$USE_THREE_ARG_MODE" = "true" ]; then
        local meta_title="$output_prefix"
    else
        local meta_title="$prefix_colon"
    fi

    # Build subtitle options based on mode
    local subtitle_opts="-sn"

    if [ "$INCLUDE_SUBTITLES" = "true" ] && [ -n "$FORCED_SUB_MAP" ]; then
        # Use detected/mapped subtitles when enabled
        subtitle_opts="$FORCED_SUB_MAP $SUBTITLE_CODEC"
    elif [ "$HARD_SUB" = "true" ]; then
        # Hard encode all subtitles (for backwards compatibility with -h)
        subtitle_opts=$(echo "$subtitle_opts" | sed 's/-sn//')
    fi

    local cmd="ffmpeg -y -i \"$filename\" $subtitle_opts $SCALE_FILTER -map_chapters -1 -map_metadata -1 -map 0:v:0 -map 0:a:$AUDIO_INDEX -metadata title=\"$meta_title\" -metadata genre=\"$METADATA_GENRE\" -vcodec $enc -b:v ${target_bitrate}k -pix_fmt yuv420p -acodec libmp3lame -b:a 128k -filter:a loudnorm -f mp4 tmp_$PID.mp4 </dev/null"
    echo "$cmd"
}

# --- Execution Loop ---
exec_attempt=1
while true; do
    current_enc=$OUTPUT_ENC
    if [ $exec_attempt -gt 1 ]; then
        current_enc="libx264"
    fi

    echo "Attempt $exec_attempt (Encoder: $current_enc)..."
    CMD=$(build_cmd "$current_enc")
    eval "$CMD"

    if [ $? -eq 0 ]; then
        break
    else
        echo "Attempt $exec_attempt failed."
        exec_attempt=$((exec_attempt + 1))
        if [ $exec_attempt -gt 2 ]; then
            echo "Both primary and fallback attempts failed."
            exit 1
        fi
    fi
done

# --- Finalization ---
touch -r .timestamp_$PID tmp_$PID.mp4

# Create destination directory if needed (use output prefix for path in 3-arg mode)
mkdir -p /mnt/HDD/films/"$DEST_PATH"

if [ "$REPLACE_COLON" = "true" ]; then
    # If dashes were replaced, copy the file with new name and remove original
    mv -v tmp_$PID.mp4 /mnt/HDD/films/"$DEST_PATH"/"$new_filename"
    rm -f "$filename"
else
    # Original behavior - just move the temp file
    mv -v tmp_$PID.mp4 /mnt/HDD/films/"$DEST_PATH"/"$new_filename"
fi

rm -f .timestamp_$PID
exit 0
