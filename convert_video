#!/bin/bash

# Use Case:
# - Default: GPU encoding (h264_v4l2m2m), outputs to /mnt/HDD/films/{genre}/
# - No GPU: Uses libx264 (triggered by -n or if primary fails)
# - 1080p scaling: Adds scale=1920:1080 filter (triggered by -s)
# - Audio selection: Stream index (triggered by -a)
# - Subtitles: Hard-encoding / no-strip (triggered by -h or --forced)
# - Colon replacement: In filename and metadata (triggered by -c)

# Usage: ./convert_video [options] <filename> [genre]
# Options:
#   -n, --no-gpu      Force software encoding (libx264)
#   -s, --1080p       Scale 2160p down to 1080p
#   -a, --audio <id>  Specify audio stream index (default: 0)
#   -h, --hard_sub    Hard encode all subtitles
#   --forced          Include only forced UK/English subtitles (hard-encoded)
#   -c, --colon       Replace dashes with colons in filename and metadata

# Legacy script equivalents:
#   ./convert_video_just_HD <file>             => ./convert_video <file>
#   ./convert_video_without_GPU_just_HD <file> => ./convert_video -n <file>
#   ./convert_video_both_HD_and_iPad <file>    => ./convert_video <file> (HD only, iPad obsolete)

# Variables
OUTPUT_ENC="h264_v4l2m2m"
SCALE_FILTER=""
AUDIO_INDEX=0
HARD_SUB=false
FORCED_SUBS=false
FORCE_NO_GPU=false
REPLACE_COLON=false

# Parse options
while [[ "$#" -gt 0 ]]; do
    case $1 in
        -n|--no-gpu)
            OUTPUT_ENC="libx264"
            FORCE_NO_GPU=true
            shift
            ;;
        -s|--1080p)
            SCALE_FILTER="-vf scale=1920:1080"
            shift
            ;;
        -a|--audio)
            AUDIO_INDEX=$2
            shift 2
            ;;
        -h|--hard_sub)
            HARD_SUB=true
            shift
            ;;
        -c|--colon)
            REPLACE_COLON=true
            shift
            ;;
        --forced)
            FORCED_SUBS=true
            shift
            ;;
        *)
            break
    esac
done

filename=$1
genre=${2:-"unknown"}
# Handle special cases for Modern and Retro genres
if [[ "$genre" == "Modern" || "$genre" == "Retro" ]]; then
    METADATA_GENRE="Family"
    DEST_PATH="Family/$genre"
else
    METADATA_GENRE="$genre"
    DEST_PATH="$genre"
fi
if [ "$HARD_SUB" = "true" ] && [ "$FORCED_SUBS" = "true" ]; then
    echo "Error: Cannot use both -h/--hard_sub and --forced together"
    exit 1
fi

if [ -z "$filename" ]; then
    echo "Usage: $0 [-n] [-s] [-a <id>] [--hard_sub | --forced] [-c] <filename> [genre]"
    echo ""
    echo "Options:"
    echo "  -n, --no-gpu      Force software encoding (libx264)"
    echo "  -s, --1080p       Scale 2160p down to 1080p"
    echo "  -a, --audio <id>  Specify audio stream index (default: 0)"
    echo "  --hard_sub        Hard encode all subtitles"
    echo "  --forced          Include only forced UK/English subtitles (hard-encoded)"
    echo "  -c, --colon       Replace dashes with colons in filename and metadata"
    exit 1
fi

# --- Preparation ---
PID=$$
filename1=$(basename "$filename")
prefix=$(echo "${filename1%.*}")
prefix1=$(echo "${filename%.*}")

# Replace dashes with colons if requested
if [ "$REPLACE_COLON" = "true" ]; then
    prefix_colon=$(echo "$prefix" | sed 's/ -/:/')
else
    prefix_colon="$prefix"
fi

new_filename="${prefix_colon}.mp4"
new_filename_HD="${prefix_colon}_HD.mp4"
new_filename_iPad="${prefix_colon}_iPad.mp4"

echo "Original file name: $filename"
echo "Prefix: $prefix"
if [ "$REPLACE_COLON" = "true" ]; then
    echo "New prefix (dashes replaced): $prefix_colon"
fi
echo "New file names: ${new_filename_iPad} ${new_filename_HD} ${new_filename}"

target_bitrate=2000
# Just to keep it similar to original script's behavior of showing info
ffmpeg -i "$filename" 2>&1 | grep -E "Duration|bitrate" || true
echo "Target bitrate: ${target_bitrate}k"

# Handle forced subtitles - detect and map only forced English/UK subtitle streams
FORCED_SUB_MAP=""
SUBTITLE_CODEC=""
if [ "$FORCED_SUBS" = "true" ]; then
    echo "Looking for forced UK/English subtitle streams..."
    # Get list of subtitle streams from ffmpeg output
    SUBTITLE_INFO=$(ffmpeg -i "$filename" 2>&1)

    # Look for lines like: Stream #0:2(eng): Subtitle: subrip (srt) (default) (forced)
    FORCED_STREAM_LINE=$(echo "$SUBTITLE_INFO" | grep "Subtitle.*forced" | head -1)

    if [ -n "$FORCED_STREAM_LINE" ]; then
        # Extract stream index from line like "Stream #0:2(eng): Subtitle..."
        STREAM_INDEX=$(echo "$FORCED_STREAM_LINE" | sed -n 's/.*Stream #0:\([0-9]\+\).*/\1/p')

        if [ -n "$STREAM_INDEX" ]; then
            echo "Found forced subtitle stream at index $STREAM_INDEX"
            FORCED_SUB_MAP="-map 0:s:$STREAM_INDEX -c:s mov_text"
            SUBTITLE_CODEC="-metadata:s:s:0 language=eng"
        else
            echo "Warning: Could not parse stream index from forced subtitle line"
        fi
    else
        # No forced subtitles found, try to find any English subtitle as fallback
        ENG_STREAM_LINE=$(echo "$SUBTITLE_INFO" | grep "Subtitle:" | head -1)
        if [ -n "$ENG_STREAM_LINE" ]; then
            STREAM_INDEX=$(echo "$ENG_STREAM_LINE" | sed -n 's/.*Stream #0:\([0-9]\+\).*/\1/p')
            echo "No forced subtitles found, using first subtitle stream at index $STREAM_INDEX"
            FORCED_SUB_MAP="-map 0:s:$STREAM_INDEX -c:s mov_text"
            SUBTITLE_CODEC="-metadata:s:s:0 language=eng"
        else
            echo "Warning: No subtitle streams found in input file"
        fi
    fi
fi

touch -r "$filename" .timestamp_$PID

# Helper function to generate the ffmpeg command string
build_cmd() {
    local enc=$1
    # Use colon-prefixed prefix for metadata title
    local meta_title="$prefix_colon"

    # Build subtitle options based on mode
    local subtitle_opts="-sn"
    if [ "$FORCED_SUBS" = "true" ] && [ -n "$FORCED_SUB_MAP" ]; then
        # Use forced subtitles when --forced is specified and stream found
        subtitle_opts="$FORCED_SUB_MAP $SUBTITLE_CODEC"
    elif [ "$HARD_SUB" = "true" ]; then
        # Hard encode all subtitles (for backwards compatibility with -h)
        subtitle_opts=$(echo "$subtitle_opts" | sed 's/-sn//')
    fi

    local cmd="ffmpeg -y -i \"$filename\" $subtitle_opts $SCALE_FILTER -map_chapters -1 -map_metadata -1 -map 0:v:0 -map 0:a:$AUDIO_INDEX -metadata title=\"$meta_title\" -metadata genre=\"$METADATA_GENRE\" -vcodec $enc -b:v ${target_bitrate}k -pix_fmt yuv420p -acodec libmp3lame -b:a 128k -filter:a loudnorm -f mp4 tmp_$PID.mp4 </dev/null"
    echo "$cmd"
}

# --- Execution Loop ---
exec_attempt=1
while true; do
    current_enc=$OUTPUT_ENC
    if [ $exec_attempt -gt 1 ]; then
        current_enc="libx264"
    fi

    echo "Attempt $exec_attempt (Encoder: $current_enc)..."
    CMD=$(build_cmd "$current_enc")
    eval "$CMD"

    if [ $? -eq 0 ]; then
        break
    else
        echo "Attempt $exec_attempt failed."
        exec_attempt=$((exec_attempt + 1))
        if [ $exec_attempt -gt 2 ]; then
            echo "Both primary and fallback attempts failed."
            exit 1
        fi
    fi
done

# --- Finalization ---
touch -r .timestamp_$PID tmp_$PID.mp4

# Create destination directory if needed (use colon-prefixed prefix for path)
mkdir -p /mnt/HDD/films/"$DEST_PATH"

if [ "$REPLACE_COLON" = "true" ]; then
    # If dashes were replaced, copy the file with new name and remove original
    mv -v tmp_$PID.mp4 /mnt/HDD/films/"$DEST_PATH"/"$new_filename"
    rm -f "$filename"
else
    # Original behavior - just move the temp file
    mv -v tmp_$PID.mp4 /mnt/HDD/films/"$DEST_PATH"/"$new_filename"
fi

rm -f .timestamp_$PID
exit 0
