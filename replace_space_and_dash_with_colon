filename=$1
new_filename=$(echo "$filename"|sed 's/ -/:/')
film_name=$(echo "$new_filename"|sed 's/.mp4//')
ffmpeg -i "$filename" -metadata title="$film_name" -c copy tmp.mp4
mv tmp.mp4 "$new_filename"
touch -r "$filename" "$new_filename"
rm "$filename"

