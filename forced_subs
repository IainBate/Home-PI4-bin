#!/bin/bash
# forced_subs - scan /mnt/HDD/films for missing forced-English subtitles,
# identify films via OpenSubtitles moviehash + a curated list, and fetch/
# remux matches within a daily API budget.
# Usage: forced_subs {identify|scan|apply|report} [options]
# See docs/superpowers/specs/2026-09-14-forced-subtitle-scanner-design.md.
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIBDIR="${FORCED_SUBS_LIBDIR:-$REPO_ROOT/lib}"
CONVERT_VIDEO="${FORCED_SUBS_CONVERT_VIDEO:-$REPO_ROOT/convert_video}"
KNOWN_FILMS_YAML="${FORCED_SUBS_KNOWN_FILMS:-$REPO_ROOT/forced_subs_known_films.yaml}"
SECRETS_YAML="${FORCED_SUBS_SECRETS_YAML:-$REPO_ROOT/secrets.yaml}"
FILMS_ROOT="${FORCED_SUBS_FILMS_ROOT:-/mnt/HDD/films}"
FID_CACHE="${FID_CACHE:-/home/pi/logs/forced_subs_file_ids}"
UNAVAILABLE_CACHE="${UNAVAILABLE_CACHE:-/home/pi/logs/forced_subs_unavailable_cache}"
APPLY_LOG="${APPLY_LOG:-/home/pi/logs/forced_subs_apply_logfile}"
SCAN_LOG="${SCAN_LOG:-/home/pi/logs/forced_subs_scan_logfile}"
SCAN_CACHE="${SCAN_CACHE:-/home/pi/logs/forced_subs_scan_cache}"
REPORT_FILE="${FORCED_SUBS_REPORT_FILE:-/home/pi/logs/forced_subs_report.txt}"
LOCKFILE="${FORCED_SUBS_LOCKFILE:-/tmp/forced_subs.lock}"
# How long a non-HAS_FORCED scan result is trusted before being re-probed
# (HAS_FORCED itself is trusted indefinitely, gated only on the file's own
# stat signature - see cmd_scan). Films that are still unfetched, ambiguous,
# or genuinely unmatched won't resolve differently just by re-checking them
# every single day; a monthly deep re-probe (the crontab's `scan --rehash`
# entry) is what actually catches anything that changed since.
SCAN_FRESHNESS_DAYS="${FORCED_SUBS_SCAN_FRESHNESS_DAYS:-30}"
export FID_CACHE UNAVAILABLE_CACHE SCAN_CACHE

# shellcheck source=lib/forced_subs_common.sh
. "$LIBDIR/forced_subs_common.sh"

# --- identify -----------------------------------------------------------

forced_subs_identify_one() {
    local file="$1"
    local existing_conf
    existing_conf=$(fid_cache_get_field "$file" confidence 2>/dev/null || true)
    if [ "$existing_conf" = "manual" ]; then
        return 0
    fi
    if [ -n "$existing_conf" ] && [ "${REHASH:-false}" != "true" ]; then
        return 0
    fi

    local identified imdb_id title year confidence reason
    identified=$(identify_film_from_file "$file" "$LIBDIR" "$KNOWN_FILMS_YAML")
    # cut, not `read <<<` - bash's IFS word-splitting collapses consecutive
    # tabs (one of its "IFS whitespace" characters) and strips them from
    # the start of the string, silently dropping leading empty fields
    # (imdb_id/title/year are all empty in the unresolved case, right
    # before confidence/reason - read would shift those into the wrong
    # variables).
    imdb_id=$(printf '%s' "$identified" | cut -f1)
    title=$(printf '%s' "$identified" | cut -f2)
    year=$(printf '%s' "$identified" | cut -f3)
    confidence=$(printf '%s' "$identified" | cut -f4)
    reason=$(printf '%s' "$identified" | cut -f5)
    fid_cache_set "$file" "$imdb_id" "$title" "$year" "$confidence" "$reason" "$(date -I)"
}

cmd_identify_set() {
    local file="$1" imdb_id="$2" lookup title="" year=""
    lookup=$(python3 "$LIBDIR/known_films.py" lookup "$KNOWN_FILMS_YAML" "$imdb_id" 2>/dev/null || true)
    if [ -n "$lookup" ]; then
        IFS=$'\t' read -r title year _ <<< "$lookup"
    fi
    fid_cache_set "$file" "$imdb_id" "$title" "$year" "manual" "" "$(date -I)"
}

cmd_identify() {
    REHASH=false
    local set_path="" set_imdb=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --rehash) REHASH=true; shift ;;
            --set) set_path="$2"; set_imdb="$3"; shift 3 ;;
            *) shift ;;
        esac
    done
    if [ -n "$set_path" ]; then
        cmd_identify_set "$set_path" "$set_imdb"
        return 0
    fi
    while IFS= read -r file; do
        forced_subs_identify_one "$file"
    done < <(walk_films "$FILMS_ROOT")
}

# --- scan -----------------------------------------------------------------

# scan_cache row: path \t file_stat_signature \t <the 8-field result line> \t
# checked_date. See "Incremental scanning" in the spec: lets scan skip
# re-probing a file whose size/mtime haven't changed since it was last
# checked. A HAS_FORCED result is trusted indefinitely on that basis alone;
# any other bucket is also trusted, but only for SCAN_FRESHNESS_DAYS - see
# cmd_scan.
cmd_scan() {
    local rehash=false
    while [ $# -gt 0 ]; do
        case "$1" in
            --rehash) rehash=true; shift ;;
            *) shift ;;
        esac
    done
    # Reuses forced_subs_identify_one's own REHASH switch: a deep `scan
    # --rehash` should also give previously-unresolved titles another shot
    # at re-identification, not just re-probe convert_video.
    [ "$rehash" = "true" ] && REHASH=true
    while IFS= read -r file; do
        local sig cached_row
        sig=$(file_stat_signature "$file")
        if cached_row=$(scan_cache_get "$file"); then
            local cached_sig cached_bucket cached_checked
            cached_sig=$(printf '%s' "$cached_row" | cut -f2)
            cached_bucket=$(printf '%s' "$cached_row" | cut -f3)
            cached_checked=$(printf '%s' "$cached_row" | cut -f11)
            if [ "$cached_sig" = "$sig" ]; then
                if [ "$cached_bucket" = "HAS_FORCED" ]; then
                    printf '%s\n' "$cached_row" | cut -f3-10
                    continue
                fi
                if [ "$rehash" != "true" ] && [ -n "$cached_checked" ]; then
                    local age_days
                    age_days=$(( ( $(epoch_of_date "$(date +%Y-%m-%d)") - $(epoch_of_date "$cached_checked") ) / 86400 ))
                    if [ "$age_days" -lt "$SCAN_FRESHNESS_DAYS" ]; then
                        printf '%s\n' "$cached_row" | cut -f3-10
                        continue
                    fi
                fi
            fi
        fi

        local analyze forced coverage external bucket imdb_id="" title="" edition="" reason=""
        analyze=$("$CONVERT_VIDEO" --analyze-subs "$file" 2>/dev/null)
        forced=$(printf '%s' "$analyze" | grep -oE 'FORCED=[0-9]+' | cut -d= -f2)
        coverage=$(printf '%s' "$analyze" | grep -oE 'COVERAGE=[0-9.]+' | cut -d= -f2)
        external=$(printf '%s' "$analyze" | grep -oE 'EXTERNAL_SRT=[0-9]+' | cut -d= -f2)

        # >0, not a higher floor like 15%: genuine forced-subtitle content
        # covers only the foreign-language lines in an otherwise-English
        # film, typically well under 10% of the runtime - a real match is
        # usually a small percentage, not a large one. (The >=15% floor
        # this replaced was inherited from convert_video's own coverage
        # calculation, which had a real bug of its own - see the note in
        # convert_video's analyze_subtitles - that made any genuine
        # sub-~10% coverage compute as exactly 0 regardless of the fix
        # here; both needed correcting together.) A mislabeled *full*
        # dialogue track would show up around 60-100%, so >0 alone doesn't
        # risk conflating the two.
        local has_real_forced=false
        if [ "${forced:-0}" = "1" ] && awk -v c="${coverage:-0}" 'BEGIN{exit !(c>0)}'; then
            has_real_forced=true
        fi

        if [ "$has_real_forced" = "true" ]; then
            bucket="HAS_FORCED"
        else
            if [ "$rehash" = "true" ] || ! fid_cache_get_field "$file" confidence >/dev/null 2>&1; then
                forced_subs_identify_one "$file"
            fi
            imdb_id=$(fid_cache_get_field "$file" imdb_id 2>/dev/null || true)
            title=$(fid_cache_get_field "$file" title 2>/dev/null || true)
            if [ -z "$imdb_id" ]; then
                bucket="NEEDS_FORCED_UNKNOWN"
                reason=$(fid_cache_get_field "$file" reason 2>/dev/null || echo "unresolved")
            else
                # Any resolved imdb_id is now eligible for fetching,
                # whether it came from the hash match, the curated list's
                # filename fallback, or the title-search fallback (see
                # forced_subs_identify_one) - known_films.yaml's role has
                # narrowed to supplying EXTRA edition-safety data for
                # titles with real multiple cuts (see cmd_apply's
                # edition_count handling), not gating whether a film gets
                # attempted at all. A lookup miss just means no such data
                # exists for this title; edition stays empty and
                # cmd_apply's multi-edition guard is simply never
                # triggered for it (edition_count 0 or 1).
                bucket="NEEDS_FORCED_KNOWN"
                local lookup editions
                lookup=$(python3 "$LIBDIR/known_films.py" lookup "$KNOWN_FILMS_YAML" "$imdb_id" 2>/dev/null || true)
                IFS=$'\t' read -r _ _ editions <<< "$lookup"
                edition=$(pick_edition "$file" "$editions")
            fi
        fi
        local result_line
        result_line=$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' "$bucket" "$file" "$imdb_id" "$title" "$edition" "${coverage:-0}" "${external:-0}" "$reason")
        scan_cache_set "$file" "$sig" "$result_line"
        printf '%s\n' "$result_line"
    done < <(walk_films "$FILMS_ROOT")
}

# --- apply ------------------------------------------------------------

find_sidecar_srt() {
    local file="$1" dir base
    dir=$(dirname "$file")
    base=$(basename "$file")
    base="${base%.*}"
    find "$dir" -maxdepth 1 -iname "${base}.srt" -print -quit
}

epoch_of_date() {
    date -d "$1" +%s 2>/dev/null || date -j -f '%Y-%m-%d' "$1" +%s
}

unavailable_cache_is_fresh() {
    local file="$1"
    [ -f "$UNAVAILABLE_CACHE" ] || return 1
    local last_checked
    last_checked=$(awk -F'\t' -v p="$file" '$1==p {v=$3} END{print v}' "$UNAVAILABLE_CACHE")
    [ -n "$last_checked" ] || return 1
    local age_days
    age_days=$(( ( $(epoch_of_date "$(date +%Y-%m-%d)") - $(epoch_of_date "$last_checked") ) / 86400 ))
    [ "$age_days" -lt 7 ]
}

unavailable_cache_set() {
    local file="$1" reason="$2"
    mkdir -p "$(dirname "$UNAVAILABLE_CACHE")"
    touch "$UNAVAILABLE_CACHE"
    local tmp
    tmp=$(mktemp)
    awk -F'\t' -v p="$file" '$1 != p' "$UNAVAILABLE_CACHE" > "$tmp"
    printf '%s\t%s\t%s\n' "$file" "$reason" "$(date -I)" >> "$tmp"
    mv "$tmp" "$UNAVAILABLE_CACHE"
}

log_apply() {
    mkdir -p "$(dirname "$APPLY_LOG")" 2>/dev/null || true
    printf '%s\t%s\t%s\t%s\n' "$(date -Iseconds)" "$1" "$2" "$3" >> "$APPLY_LOG"
}

cmd_apply() {
    local max_downloads="$1"
    local success_count=0
    local consecutive_errors=0
    while IFS=$'\t' read -r bucket file imdb_id title edition coverage external reason; do
        [ "$bucket" = "NEEDS_FORCED_KNOWN" ] || continue
        [ "$success_count" -lt "$max_downloads" ] || break
        unavailable_cache_is_fresh "$file" && continue

        # A sidecar .srt is only trusted when it exists AND its own cue
        # coverage is low (mirrors the 15% forced-vs-full-track threshold
        # used elsewhere for embedded streams). Anything else (no matching
        # sidecar, or a full-length dialogue track sitting next to the
        # film) falls through to the normal search path below, exactly as
        # if $external had been 0 all along.
        local srt_path=""
        if [ "$external" = "1" ]; then
            local candidate_srt
            candidate_srt=$(find_sidecar_srt "$file")
            if [ -n "$candidate_srt" ]; then
                local video_duration coverage_pct
                video_duration=$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$file" 2>/dev/null)
                coverage_pct=$(srt_coverage_percent "$candidate_srt" "$video_duration")
                if awk -v c="$coverage_pct" 'BEGIN{exit !(c<15)}'; then
                    srt_path="$candidate_srt"
                fi
            fi
        fi

        if [ -z "$srt_path" ]; then
            # find_forced_subtitle (lib/forced_subs_common.sh) does the
            # edition-exact hash search, then - if that's empty - the
            # runtime-unfiltered IMDb fallback with the edition-safety
            # check, shared with convert_video's own single-file fetch.
            # ost.py's _request calls sys.exit(1) on any HTTP/network
            # error and prints nothing on stdout in that case - a
            # *_search_failed status reliably means "the call errored"
            # (credentials/outage; NOT safe to cache as unavailable, it
            # may well have a match), while every other non-success
            # status means "genuinely no match/ambiguous/download issue"
            # (safe to cache). A run of 3 consecutive errors aborts early
            # rather than burning through every remaining candidate.
            local find_result status
            find_result=$(find_forced_subtitle "$file" "$imdb_id" "$edition" "$KNOWN_FILMS_YAML" "$LIBDIR" "$APPLY_LOG")
            status=$(printf '%s' "$find_result" | cut -f1)
            srt_path=$(printf '%s' "$find_result" | cut -f2)

            case "$status" in
                success)
                    consecutive_errors=0
                    ;;
                hash_search_failed|imdb_search_failed)
                    consecutive_errors=$((consecutive_errors + 1))
                    log_apply "$file" "error" "$status"
                    if [ "$consecutive_errors" -ge 3 ]; then
                        echo "ERROR: 3 consecutive OpenSubtitles API failures - aborting apply run early." >&2
                        return 1
                    fi
                    continue
                    ;;
                *)
                    consecutive_errors=0
                    unavailable_cache_set "$file" "$status"
                    log_apply "$file" "unavailable" "$status"
                    continue
                    ;;
            esac
        fi

        if [ -n "$srt_path" ] && remux_forced_subtitle "$file" "$srt_path"; then
            log_apply "$file" "success" "remuxed"
            success_count=$((success_count + 1))
        else
            unavailable_cache_set "$file" "remux_failed"
            log_apply "$file" "unavailable" "remux_failed"
        fi
    done < <(cmd_scan)
}

# --- report -----------------------------------------------------------

report_body() {
    local verbose="$1"
    local scan_output
    scan_output=$(cmd_scan)

    echo "=== Already fine ==="
    local has_forced_count
    has_forced_count=$(printf '%s\n' "$scan_output" | awk -F'\t' '$1=="HAS_FORCED"' | wc -l | tr -d ' ')
    echo "$has_forced_count file(s) already have forced subs."
    if [ "$verbose" = "true" ]; then
        printf '%s\n' "$scan_output" | awk -F'\t' '$1=="HAS_FORCED" {print "  " $2}'
    fi

    echo ""
    echo "=== Added by this script ==="
    if [ -f "$APPLY_LOG" ]; then
        awk -F'\t' '$3=="success" {print "  " $2}' "$APPLY_LOG" | sort -u
    fi

    # Split what used to be one flat "sort these out yourself" dump into
    # sections by what action each one actually needs, instead of lumping
    # identified-but-unfetched films in with thousands of TV episodes that
    # were never identifiable as films at all (see forced_subs_identify_one
    # and cmd_scan's NEEDS_FORCED_UNKNOWN reasons for where each of these
    # reason codes comes from). Any resolved film - curated in
    # forced_subs_known_films.yaml or not - is attempted by apply, so this
    # no longer distinguishes "curated" from "identified via title-search":
    # both land here identically if the fetch itself came back empty.
    echo ""
    echo "=== Needs forced subtitles - you decide what to do ==="

    local unfetched
    unfetched=$(printf '%s\n' "$scan_output" | awk -F'\t' '$1=="NEEDS_FORCED_KNOWN"' | while IFS=$'\t' read -r bucket file imdb_id title edition coverage external reason; do
        if unavailable_cache_is_fresh "$file"; then
            local r
            r=$(awk -F'\t' -v p="$file" '$1==p {v=$2} END{print v}' "$UNAVAILABLE_CACHE")
            echo "  $file ($r)"
        fi
    done)
    if [ -n "$unfetched" ]; then
        echo ""
        echo "-- Identified, but no matching subtitle could be fetched automatically --"
        printf '%s\n' "$unfetched"
    fi

    local ambiguous_year
    ambiguous_year=$(printf '%s\n' "$scan_output" | awk -F'\t' '$1=="NEEDS_FORCED_UNKNOWN" && $8=="ambiguous_title_multiple_years" {print "  " $2}')
    if [ -n "$ambiguous_year" ]; then
        echo ""
        echo "-- Multiple curated titles/years match this filename - needs disambiguation (forced_subs identify --set) --"
        printf '%s\n' "$ambiguous_year"
    fi

    local unidentified_count
    unidentified_count=$(printf '%s\n' "$scan_output" | awk -F'\t' '$1=="NEEDS_FORCED_UNKNOWN" && $8=="no_match"' | wc -l | tr -d ' ')
    if [ "$unidentified_count" -gt 0 ]; then
        echo ""
        echo "$unidentified_count file(s) have no confident film match at all (mostly TV episodes, or titles the title-search fallback couldn't confidently resolve either) - not shown individually."
    fi
}

cmd_report() {
    local verbose="$1"
    # Deliberately not under $FILMS_ROOT: the media library is not the
    # right place for this tool's own bookkeeping output, matching every
    # other forced_subs log/cache file's location under /home/pi/logs.
    mkdir -p "$(dirname "$REPORT_FILE")" 2>/dev/null || true
    report_body "$verbose" | tee "$REPORT_FILE"
}

# --- dispatch -------------------------------------------------------------

main() {
    local cmd="${1:-}"
    shift || true
    # /mnt/HDD is an external USB drive. If it's unmounted, an empty
    # FILMS_ROOT would otherwise look like a false "all clear" to
    # scan/apply/report (REPORT_FILE no longer lives under FILMS_ROOT at
    # all - see cmd_report - so this guard is purely about not silently
    # scanning zero files and calling that "done"). A real, non-empty
    # directory is a reasonable "is it mounted" proxy without depending on
    # the `mountpoint` command being installed.
    if [ ! -d "$FILMS_ROOT" ] || [ -z "$(find "$FILMS_ROOT" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]; then
        echo "ERROR: $FILMS_ROOT doesn't exist or is empty - is /mnt/HDD actually mounted?" >&2
        exit 1
    fi
    case "$cmd" in
        identify)
            load_opensubtitles_creds "$SECRETS_YAML"
            load_tmdb_creds "$SECRETS_YAML"
            cmd_identify "$@"
            ;;
        scan)
            load_opensubtitles_creds "$SECRETS_YAML"
            load_tmdb_creds "$SECRETS_YAML"
            mkdir -p "$(dirname "$SCAN_LOG")" 2>/dev/null || true
            cmd_scan "$@" | tee -a "$SCAN_LOG"
            ;;
        apply)
            local max=5 quiet=false
            while [ $# -gt 0 ]; do
                case "$1" in
                    --max-downloads) max="$2"; shift 2 ;;
                    --quiet) quiet=true; shift ;;
                    *) shift ;;
                esac
            done
            load_tmdb_creds "$SECRETS_YAML"
            opensubtitles_login "$SECRETS_YAML" "$LIBDIR" || exit 1
            if [ "$quiet" = "true" ]; then
                cmd_apply "$max" >>"$APPLY_LOG" 2>&1
            else
                cmd_apply "$max"
            fi
            ;;
        report)
            load_opensubtitles_creds "$SECRETS_YAML"
            load_tmdb_creds "$SECRETS_YAML"
            local verbose=false
            [ "${1:-}" = "--verbose" ] && verbose=true
            cmd_report "$verbose"
            ;;
        *)
            echo "Usage: forced_subs {identify|scan|apply|report} [options]" >&2
            exit 2
            ;;
    esac
}

# crontab.txt schedules apply daily, identify weekly, and identify again
# @reboot - all three read-filter-rewrite the same cache files via a
# non-atomic read-then-mv pattern. A non-blocking lock makes a second
# concurrent invocation (any subcommand) fail fast instead of racing.
if command -v flock >/dev/null 2>&1; then
    (
        flock -n 9 || { echo "Another forced_subs run is already in progress - exiting." >&2; exit 1; }
        main "$@"
    ) 9>"$LOCKFILE"
else
    # Portable fallback for platforms without flock (e.g. macOS, used here
    # during development/testing - the Pi's Debian-based OS has flock as
    # standard). mkdir is atomic on POSIX filesystems, so this still fails
    # fast against a genuinely concurrent run.
    lockdir="${LOCKFILE}.d"
    if ! mkdir "$lockdir" 2>/dev/null; then
        echo "Another forced_subs run is already in progress - exiting." >&2
        exit 1
    fi
    trap 'rmdir "$lockdir" 2>/dev/null' EXIT
    main "$@"
fi
