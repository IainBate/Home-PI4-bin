find /mnt/HDD/ -mindepth 1 -maxdepth 1 -type d -not -path '*/\.*' | while read n; do
	m=$(echo "$n"|sed 's/\/mnt\/HDD\///')
	if [[ "$n" != *"tmp"* && "$n" != *"photos"* && "$n" != *"files"* && "$n" != *"Go Pros"* && "$n" != *"PI backup"* ]]; then
		if [[ "$n" != *"lost"* && "$n" != *"olympus_tg4"* && "$n" != *"iPhones"* && "$n" != *"Trash"* && "$n" != *"iTunes"* ]]; then
			echo "rsync'ing" "$n/" "/media/pi/Caravan/$m/"
			mkdir -p "/media/pi/Caravan/$m/"
			if [[ "$n" == *"films"* ]]; then
				rsync --archive --delete --progress --delete-excluded --exclude "/Our Family" --exclude "/Friends" --exclude "/Modern Family" --exclude "/H2O - Just Add Water" --exclude "*DS_Store*" "$n/" /media/pi/Caravan/"$m"/
			else	
				rsync --archive --delete --progress --delete-excluded --max-size=1G "$n/" /media/pi/Caravan/"$m"/
			fi	
		fi
	fi
done

